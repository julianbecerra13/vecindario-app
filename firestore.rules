rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funciones helper ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCommunityMember(communityId) {
      return isAuthenticated() && getUserData().communityId == communityId;
    }

    function isCommunityAdmin(communityId) {
      return isCommunityMember(communityId) && getUserData().communityRole == 'admin';
    }

    function isVerified() {
      return isAuthenticated() && getUserData().verified == true;
    }

    function isVerifiedMember(communityId) {
      return isCommunityMember(communityId)
        && (getUserData().verified == true || getUserData().communityRole == 'admin');
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && 'platformRole' in getUserData()
        && getUserData().platformRole == 'super_admin';
    }

    // --- Usuarios ---
    match /users/{uid} {
      allow read: if isOwner(uid)
        || isSuperAdmin()
        || (isCommunityAdmin(resource.data.communityId)
            && resource.data.communityId != null);
      allow create: if isOwner(uid)
        && request.resource.data.verified == false
        && request.resource.data.communityRole == 'resident'
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'phone', 'photoURL', 'communityId',
          'communityRole', 'estrato', 'verified', 'tower', 'apartment',
          'createdAt', 'deletedAt'
        ]);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['verified', 'communityRole', 'platformRole', 'createdAt'])
        && (request.resource.data.communityId == resource.data.communityId
            || (resource.data.communityId == null
                && resource.data.verified == false
                && request.resource.data.verified == false));
      allow delete: if false;

      // Notificaciones del usuario
      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }

      // Consentimientos y preferencias
      match /consents/{consentId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if false;
      }

      // Preferencias de privacidad
      match /consents/preferences {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if isOwner(uid);
        allow delete: if false;
      }
    }

    // --- Colecciones de Grupo (collection group queries) ---
    match /{path=**}/fines/{fineId} {
      allow read: if isCommunityAdmin(path[1])
        || (isVerifiedMember(path[1])
            && resource.data.residentUid == request.auth.uid);
    }

    // --- Comunidades ---
    // Resolución exacta de códigos de invitación para onboarding. No se
    // permite listar la colección, por lo que conocer el código es obligatorio.
    match /invite_codes/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create, update, delete: if isSuperAdmin();
    }

    function isAccessOperator(communityId) {
      return isVerifiedMember(communityId) && (
        isCommunityAdmin(communityId) ||
        exists(/databases/$(database)/documents/communities/$(communityId)/access_staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/communities/$(communityId)/access_staff/$(request.auth.uid)).data.active == true);
    }

    match /communities/{communityId}/access_staff/{uid} {
      allow read: if isOwner(uid) || isCommunityAdmin(communityId);
      allow write: if isCommunityAdmin(communityId)
        && request.resource.data.keys().hasOnly(['active', 'updatedAt'])
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
    }
    match /communities/{communityId}/access_status/{uid} {
      allow get: if isAccessOperator(communityId) ||
        (isVerifiedMember(communityId) && isOwner(uid));
      allow list: if isCommunityAdmin(communityId);
      allow create, update: if isCommunityAdmin(communityId)
        && request.resource.data.keys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['current', 'overdue', 'unknown']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /communities/{communityId}/access_tokens/{token} {
      allow get: if isAccessOperator(communityId) ||
        (isVerifiedMember(communityId) && isOwner(resource.data.residentUid));
      allow list: if false;
      allow create: if isVerifiedMember(communityId)
        && request.resource.data.keys().hasOnly(['residentUid', 'name', 'unit', 'createdAt', 'expiresAt', 'used'])
        && request.resource.data.residentUid == request.auth.uid
        && request.resource.data.name == getUserData().displayName
        && request.resource.data.unit is string
        && request.resource.data.unit.size() <= 150
        && request.resource.data.unit == (getUserData().tower != null && getUserData().apartment != null
          ? 'Torre ' + getUserData().tower + ' - Apto ' + getUserData().apartment : '')
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(5, 'm')
        && request.resource.data.used == false;
      allow update: if isAccessOperator(communityId)
        && resource.data.used == false && resource.data.expiresAt > request.time
        && request.resource.data.used == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used'])
        && getAfter(/databases/$(database)/documents/communities/$(communityId)/access_logs/$(token)).data.operatorUid == request.auth.uid;
      allow delete: if false;
    }
    match /communities/{communityId}/access_logs/{token} {
      allow read: if isCommunityAdmin(communityId);
      allow create: if isAccessOperator(communityId)
        && get(/databases/$(database)/documents/users/$(request.resource.data.residentUid)).data.verified == true
        && get(/databases/$(database)/documents/users/$(request.resource.data.residentUid)).data.communityId == communityId
        && request.resource.data.keys().hasOnly(['residentUid', 'operatorUid', 'zone', 'residents', 'visitors', 'createdAt'])
        && request.resource.data.operatorUid == request.auth.uid
        && request.resource.data.residentUid == get(/databases/$(database)/documents/communities/$(communityId)/access_tokens/$(token)).data.residentUid
        && get(/databases/$(database)/documents/communities/$(communityId)/access_tokens/$(token)).data.used == false
        && get(/databases/$(database)/documents/communities/$(communityId)/access_tokens/$(token)).data.expiresAt > request.time
        && getAfter(/databases/$(database)/documents/communities/$(communityId)/access_tokens/$(token)).data.used == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.zone is string && request.resource.data.zone.size() > 0 && request.resource.data.zone.size() <= 100
        && request.resource.data.residents is int && request.resource.data.residents >= 1 && request.resource.data.residents <= 50
        && request.resource.data.visitors is int && request.resource.data.visitors >= 0 && request.resource.data.visitors <= 50;
      allow update, delete: if false;
    }

    match /communities/{communityId} {
      allow read: if isCommunityMember(communityId) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isCommunityAdmin(communityId) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Posts del feed
      match /posts/{postId} {
        allow read: if isVerifiedMember(communityId);
        allow create: if isVerifiedMember(communityId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isCommunityAdmin(communityId)
          || (isVerifiedMember(communityId)
              && isOwner(resource.data.authorUid)
              && request.resource.data.authorUid == resource.data.authorUid
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['text', 'imageURLs', 'type']))
          || (isVerifiedMember(communityId)
              && request.resource.data.authorUid == resource.data.authorUid
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['likedBy', 'likes', 'pollOptions', 'commentCount']));
        allow delete: if isOwner(resource.data.authorUid) || isCommunityAdmin(communityId);
      }

      // Comentarios de posts
      match /posts/{postId}/comments/{commentId} {
        allow read: if isVerifiedMember(communityId);
        allow create: if isVerifiedMember(communityId)
          && request.resource.data.authorUid == request.auth.uid;
        allow delete: if isOwner(resource.data.authorUid) || isCommunityAdmin(communityId);
      }

      // Reportes de posts
      match /posts/{postId}/reports/{reportId} {
        allow read: if isCommunityAdmin(communityId);
        allow create: if isVerifiedMember(communityId)
          && request.resource.data.reporterUid == request.auth.uid;
        allow delete: if false;
      }

      // --- Colecciones Premium (Vecindario Admin) ---
      // Solo se habilitan cuando admin_premium == true via Remote Config

      // Circulares oficiales
      match /circulars/{circularId} {
        allow read: if isVerifiedMember(communityId);
        allow create: if isCommunityAdmin(communityId);
        allow update: if isCommunityAdmin(communityId)
          || (isVerifiedMember(communityId)
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['readBy', 'ackBy']));
        allow delete: if isCommunityAdmin(communityId);
      }

      // Multas
      match /fines/{fineId} {
        allow read: if isCommunityAdmin(communityId)
          || (isVerifiedMember(communityId)
              && resource.data.residentUid == request.auth.uid);
        allow create: if isCommunityAdmin(communityId);
        allow update: if isCommunityAdmin(communityId)
          || (isVerifiedMember(communityId)
              && resource.data.residentUid == request.auth.uid
              && request.resource.data.residentUid == resource.data.residentUid
              && resource.data.status in ['notified', 'defense']
              && request.resource.data.status == 'defense'
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['defenseText', 'status']));
        allow delete: if false;
      }

      // Amenidades (zonas sociales)
      match /amenities/{amenityId} {
        allow read: if isVerifiedMember(communityId);
        allow create, update, delete: if isCommunityAdmin(communityId);
      }

      // Reservas
      match /bookings/{bookingId} {
        allow read: if isCommunityAdmin(communityId)
          || (isVerifiedMember(communityId)
              && resource.data.residentUid == request.auth.uid);
        allow create: if isVerifiedMember(communityId)
          && request.resource.data.residentUid == request.auth.uid
          && request.resource.data.slotKey == bookingId
          && request.resource.data.status == 'confirmed'
          && request.resource.data.createdAt == request.time;
        allow update: if isCommunityAdmin(communityId);
        allow delete: if false;
      }

      // Finanzas
      match /finances/{financeId} {
        allow read: if isVerifiedMember(communityId);
        allow create, update, delete: if isCommunityAdmin(communityId);
      }

      // Presupuestos
      match /budgets/{budgetId} {
        allow read: if isVerifiedMember(communityId);
        allow create, update, delete: if isCommunityAdmin(communityId);
      }

      // Estados de cuenta
      match /account_statements/{statementId} {
        allow read: if isCommunityAdmin(communityId)
          || (isVerifiedMember(communityId)
              && resource.data.residentUid == request.auth.uid);
        allow create, update, delete: if isCommunityAdmin(communityId);
      }

      // Manual de convivencia
      match /manual_versions/{versionId} {
        allow read: if isVerifiedMember(communityId);
        allow create, update, delete: if isCommunityAdmin(communityId);
      }

      // Asambleas
      match /assemblies/{assemblyId} {
        allow read: if isVerifiedMember(communityId);
        allow create, update: if isCommunityAdmin(communityId);
        allow delete: if false;
      }

      // PQRS
      match /pqrs/{pqrsId} {
        allow read: if isCommunityAdmin(communityId)
          || (isVerifiedMember(communityId)
              && resource.data.residentUid == request.auth.uid);
        allow create: if isVerifiedMember(communityId)
          && request.resource.data.residentUid == request.auth.uid;
        allow update: if isCommunityAdmin(communityId);
        allow delete: if false;
      }
    }

    // --- Servicios de vecinos ---
    match /services/{serviceId} {
      allow read: if isAuthenticated() && isVerified()
        && resource.data.communityId == getUserData().communityId;
      allow create: if isAuthenticated() && isVerified()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.communityId == getUserData().communityId;
      allow update: if isOwner(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.communityId == resource.data.communityId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'description', 'category', 'price',
              'priceDescription', 'imageURLs', 'active', 'ownerName',
              'ownerPhotoURL', 'contactPhone', 'communityName']);
      allow delete: if isOwner(resource.data.ownerUid);
    }

    // --- Tiendas de barrio ---
    match /stores/{storeId} {
      allow read: if isAuthenticated() && isVerified()
        && resource.data.communityId == getUserData().communityId;
      allow create: if isAuthenticated() && isVerified()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.communityId == getUserData().communityId;
      allow update: if isOwner(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.communityId == resource.data.communityId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'description', 'imageURL', 'deliveryTime',
              'minOrder', 'active']);
      allow delete: if isOwner(resource.data.ownerUid);

      // Items de la tienda (subcolección)
      match /items/{itemId} {
        allow read: if isAuthenticated() && isVerified();
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
      }
    }

    // --- Pedidos ---
    match /orders/{orderId} {
      allow read: if isAuthenticated()
        && (isOwner(resource.data.buyerUid)
            || resource.data.storeOwnerUid == request.auth.uid);
      allow create: if isAuthenticated() && isVerified()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.communityId == getUserData().communityId
        && request.resource.data.storeOwnerUid ==
          get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerUid
        && request.resource.data.communityId ==
          get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.communityId
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.active == true;
      allow update: if (resource.data.storeOwnerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'confirmedAt', 'deliveredAt', 'reviewed']))
        || (isOwner(resource.data.buyerUid)
          && (resource.data.status == 'pending' || resource.data.status == 'confirmed')
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status']));
      allow delete: if false;
    }

    // --- Servicios externos ---
    match /external_services/{serviceId} {
      allow read: if isAuthenticated() && isVerified();
      allow create: if isAuthenticated() && isVerified()
        && request.resource.data.recommendedByUid == request.auth.uid;
      allow update: if isOwner(resource.data.recommendedByUid)
        && request.resource.data.recommendedByUid == resource.data.recommendedByUid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'description', 'category', 'phone', 'whatsapp',
              'website', 'imageURL', 'active']);
      allow delete: if false;
    }

    // --- Reseñas ---
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isVerified()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isOwner(resource.data.authorUid)
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'comment', 'authorName', 'authorPhotoURL']);
      allow delete: if isOwner(resource.data.authorUid);
    }

    // --- Intenciones de pago ---
    match /payment_intents/{docId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if false;
      allow update, delete: if false;
    }

    // --- Solicitudes de eliminación ---
    match /deletion_requests/{requestId} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Solicitudes de exportación de datos ---
    match /data_export_requests/{requestId} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Suscripciones ---
    // Admin de la comunidad puede crear el trial inicial (30 días).
    // Activaciones pagadas y cambios de plan los hace backend.
    match /subscriptions/{communityId} {
      allow read: if isCommunityMember(communityId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // --- Logs de auditoría (solo backend) ---
    match /audit_logs/{logId} {
      allow read: if false;
      allow create, update, delete: if false;
    }
  }
}
